# Copy to .env locally. Public Vite variables only; never put backend secrets here.
VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Base URL for API and broadcasting authorization
VITE_API_URL=http://localhost:8000

# Google Identity Services OAuth client ID (public)
VITE_GOOGLE_CLIENT_ID=

# Web Push public VAPID key (public)
VITE_VAPID_PUBLIC_KEY=
